---
import type { SectionTypeMeta } from "../data/curated";
interface Props {
  st: SectionTypeMeta;
}
const { st } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<a
  href={`${base}section-types/${st.id}/`}
  class="block rounded-xl border border-ink-200 dark:border-ink-700 p-4 bg-white dark:bg-ink-900 hover:shadow-md hover:-translate-y-0.5 transition group"
>
  <div class="flex items-center gap-2 mb-2">
    <span class="w-2.5 h-2.5 rounded-full" style={`background:${st.color}`}></span>
    <span class="font-mono text-xs px-1.5 py-0.5 rounded" style={`background:${st.color}1f;color:${st.color}`}>ST{st.id}</span>
    <span class="text-xs text-ink-500 font-mono">{st.direction}</span>
  </div>
  <h3 class="font-semibold leading-snug group-hover:text-brand-600">{st.name}</h3>
  <p class="text-xs text-ink-500 mt-0.5">{st.subtitle}</p>
  <p class="text-sm mt-2 text-ink-600 dark:text-ink-300 line-clamp-3">{st.shortPurpose}</p>
  <div class="mt-3 flex flex-wrap gap-1">
    {st.tags.map((t) => (
      <span class="text-[10px] font-mono px-1.5 rounded bg-ink-100 dark:bg-ink-800 text-ink-500">#{t}</span>
    ))}
  </div>
</a>

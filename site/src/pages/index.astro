---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionTypeCard from "../components/SectionTypeCard.astro";
import ExtensionCard from "../components/ExtensionCard.astro";
import { SECTION_TYPES, SECTION_EXTENSIONS } from "../data/curated";
import { GLOSSARY } from "../data/glossary";
const featuredST = SECTION_TYPES.filter((s) => [1, 3, 5, 6, 11].includes(s.id));
const featuredSE = SECTION_EXTENSIONS.filter((s) => [1, 6, 11, 14, 22].includes(s.id));
const base = import.meta.env.BASE_URL;

const pathway = [
  {
    code: "01",
    href: `${base}concepts/`,
    title: "용어집",
    sub: "Glossary",
    body: "PRB · beamId · eAxC · DMRS · C-Plane. 약어 한 칸씩 비유로.",
    meta: `${GLOSSARY.length} entries`,
  },
  {
    code: "02",
    href: `${base}architecture/`,
    title: "아키텍처",
    sub: "Architecture",
    body: "O-DU ↔ O-RU ↔ UE. 한 슬롯 안의 모든 신호 흐름.",
    meta: "1 slot · timing",
  },
  {
    code: "03",
    href: `${base}section-types/1/`,
    title: "Section Type 1",
    sub: "Deep dive",
    body: "5G 트래픽의 90%가 통과하는 가장 흔한 메시지. 필드부터 시각화까지.",
    meta: "§ 7.4.3",
  },
];

const stats = [
  { num: "12", label: "Section Types", clause: "§ 7.4", body: "ST0~ST11. 의도(idle, normal, PRACH, UE-specific…)를 결정." },
  { num: "30", label: "Section Extensions", clause: "§ 7.7", body: "SE1~SE30. 빔 가중치·압축·비연속 PRB·UE-port 등 보강." },
  { num: GLOSSARY.length.toString(), label: "Glossary terms", clause: "concepts", body: "PRB, DMRS, beamId, eAxC를 비유로 설명. 검색·필터링 가능." },
  { num: "04", label: "Visual modes", clause: "viz", body: "비트 레이아웃 · RB 그리드 · 빔포밍 패턴 · 메시지 시퀀스." },
];
---

<BaseLayout title="O-RAN Spec Explorer">
  <!-- Hero -->
  <section class="relative py-12 lg:py-16">
    <!-- ambient grid -->
    <div class="absolute inset-x-0 top-0 h-[420px] dot-grid pointer-events-none opacity-70" aria-hidden="true"></div>
    <div class="absolute inset-x-0 top-0 h-[420px] bg-gradient-to-b from-transparent via-transparent to-white dark:to-ink-900 pointer-events-none" aria-hidden="true"></div>

    <div class="relative grid lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      <!-- Left: oversized type -->
      <div class="lg:col-span-8">
        <!-- meta strip -->
        <div class="flex items-center gap-3 font-mono text-[10px] uppercase tracking-[0.28em] text-ink-500 mb-6">
          <span class="flex items-center gap-1.5">
            <span class="w-1 h-1 rounded-full bg-brand-500 animate-pulseLine"></span>
            O-RAN.WG4.TS.CUS
          </span>
          <span class="opacity-30">/</span>
          <span>v20.00</span>
          <span class="opacity-30">/</span>
          <span class="hidden sm:inline">Fronthaul · C/U/S-Plane</span>
        </div>

        <h1 class="font-display text-[44px] sm:text-[58px] lg:text-[76px] leading-[0.95] tracking-[-0.025em] text-balance">
          Digital Unit
          <span class="inline-block align-top text-ink-300 dark:text-ink-700 mx-1 font-light">↔</span>
          Radio Unit,
          <br/>
          <span class="italic font-light text-brand-600">decoded.</span>
        </h1>

        <p class="mt-7 max-w-[58ch] text-[16.5px] leading-[1.65] text-ink-600 dark:text-ink-300 text-pretty">
          새로 합류한 동료가 처음 봐도 — 이 메시지가 무엇을 의도하는지, 어떤 자원·UE·안테나·빔에 영향을 주는지 — 한 시간 안에 파악할 수 있도록 설계했습니다. Section Type 0~11, Section Extension 1~30, 그리고 모든 공통 필드를 비유와 그림으로 풀어냅니다.
        </p>

        <div class="mt-9 flex flex-wrap items-center gap-2">
          <a href={`${base}section-types/`} class="group inline-flex items-center gap-2 px-4 py-2.5 bg-ink-900 dark:bg-white text-white dark:text-ink-900 text-sm font-medium rounded-sm hover:bg-brand-600 dark:hover:bg-brand-500 dark:hover:text-white transition-colors">
            <span>Section Types</span>
            <span class="font-mono text-xs opacity-70 group-hover:translate-x-0.5 transition-transform">→</span>
          </a>
          <a href={`${base}extensions/`} class="inline-flex items-center gap-2 px-4 py-2.5 border hairline text-sm font-medium rounded-sm hover:bg-ink-50 dark:hover:bg-ink-800 transition-colors">
            <span>Extensions</span>
          </a>
          <a href={`${base}playground/`} class="inline-flex items-center gap-2 px-4 py-2.5 text-sm font-medium text-ink-500 hover:text-brand-600 transition-colors">
            <span class="font-mono text-xs">↳</span>
            <span>Playground</span>
          </a>
        </div>
      </div>

      <!-- Right: side rail / spec ticker -->
      <aside class="lg:col-span-4 lg:pt-2">
        <div class="relative border-l hairline pl-5 py-1 space-y-5 font-mono text-[11px]">
          <div>
            <div class="text-[9px] uppercase tracking-[0.3em] text-ink-400 mb-1">Source</div>
            <div class="text-ink-700 dark:text-ink-200">O-RAN.WG4.TS.CUS.0-R005</div>
            <div class="text-ink-500">Released · v20.00</div>
          </div>
          <div>
            <div class="text-[9px] uppercase tracking-[0.3em] text-ink-400 mb-1">Scope</div>
            <div class="text-ink-700 dark:text-ink-200">Control · User · Sync planes</div>
            <div class="text-ink-500">O-DU → O-RU fronthaul</div>
          </div>
          <div>
            <div class="text-[9px] uppercase tracking-[0.3em] text-ink-400 mb-1">Built for</div>
            <div class="text-ink-700 dark:text-ink-200 leading-relaxed font-sans normal-case tracking-normal text-[13px]">
              온보딩 30일 차 엔지니어. 비트 레이아웃부터 메시지 의도까지.
            </div>
          </div>

          <!-- decorative frame ticker -->
          <div class="pt-3 border-t hairline">
            <div class="text-[9px] uppercase tracking-[0.3em] text-ink-400 mb-2">Frame ·</div>
            <div class="grid grid-cols-10 gap-[2px]" aria-hidden="true">
              {Array.from({ length: 40 }).map((_, i) => (
                <span class={`h-2 rounded-[1px] ${[3,7,12,18,24,31,36].includes(i) ? "bg-brand-500" : i % 5 === 0 ? "bg-ink-300 dark:bg-ink-600" : "bg-ink-200/70 dark:bg-ink-700/70"}`}></span>
              ))}
            </div>
            <div class="flex justify-between mt-1.5 text-[9px] text-ink-400 tabular">
              <span>0</span><span>10</span><span>20</span><span>30</span><span>39</span>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <!-- Pathway -->
  <section class="py-10">
    <div class="flex items-baseline justify-between gap-6 mb-6 border-b hairline pb-3">
      <div>
        <div class="font-mono text-[10px] uppercase tracking-[0.3em] text-ink-500">§ Starter pathway</div>
        <h2 class="font-display text-3xl tracking-tight mt-1.5">3 steps to fluency.</h2>
      </div>
      <div class="hidden sm:block font-mono text-[10px] uppercase tracking-[0.24em] text-ink-400 tabular">~ 60 min</div>
    </div>

    <div class="grid md:grid-cols-3 gap-px bg-ink-200/60 dark:bg-ink-800 border hairline">
      {pathway.map((p) => (
        <a href={p.href} class="group relative block bg-white dark:bg-ink-900 p-6 hover:bg-brand-50/40 dark:hover:bg-brand-900/15 transition-colors">
          <div class="flex items-start justify-between mb-5">
            <div class="font-mono text-[11px] tabular tracking-wider text-ink-400 group-hover:text-brand-500 transition-colors">
              STEP / {p.code}
            </div>
            <div class="font-mono text-[10px] uppercase tracking-[0.2em] text-ink-400">
              {p.meta}
            </div>
          </div>

          <h3 class="font-display text-[28px] leading-tight tracking-tight mb-1">
            {p.title}
          </h3>
          <div class="font-mono text-[10px] uppercase tracking-[0.28em] text-brand-600 dark:text-brand-400 mb-3">
            {p.sub}
          </div>
          <p class="text-[13.5px] leading-relaxed text-ink-600 dark:text-ink-300">{p.body}</p>

          <div class="mt-6 inline-flex items-center gap-2 font-mono text-[11px] text-ink-500 group-hover:text-brand-600 transition-colors">
            <span>open</span>
            <span class="w-6 h-px bg-current"></span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Editorial stats -->
  <section class="py-12">
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-10">
      {stats.map((s, i) => (
        <div class="relative">
          <div class="absolute -top-2 left-0 font-mono text-[9px] uppercase tracking-[0.3em] text-ink-400 tabular">
            {String(i + 1).padStart(2, "0")} / {String(stats.length).padStart(2, "0")}
          </div>
          <div class="font-display italic text-[88px] leading-[0.85] tracking-[-0.03em] mt-3 tabular">
            {s.num}
          </div>
          <div class="mt-2 flex items-baseline gap-2 font-mono text-[10px] uppercase tracking-[0.22em]">
            <span class="text-ink-800 dark:text-ink-100">{s.label}</span>
            <span class="text-ink-400">{s.clause}</span>
          </div>
          <p class="mt-2.5 text-[12.5px] leading-relaxed text-ink-600 dark:text-ink-400 max-w-[28ch] text-pretty">
            {s.body}
          </p>
        </div>
      ))}
    </div>
  </section>

  <!-- Featured Section Types -->
  <section class="py-10">
    <div class="flex items-baseline justify-between gap-6 mb-6 border-b hairline pb-3">
      <div class="flex items-baseline gap-4">
        <div class="font-mono text-[10px] uppercase tracking-[0.3em] text-brand-600 dark:text-brand-400">§ 7.4</div>
        <h2 class="font-display text-3xl tracking-tight">자주 쓰는 <span class="italic">Section Types</span></h2>
      </div>
      <a href={`${base}section-types/`} class="font-mono text-[11px] uppercase tracking-[0.2em] text-ink-500 hover:text-brand-600 transition-colors">
        all 12 →
      </a>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {featuredST.map((st) => <SectionTypeCard st={st} />)}
    </div>
  </section>

  <!-- Featured Extensions -->
  <section class="py-10">
    <div class="flex items-baseline justify-between gap-6 mb-6 border-b hairline pb-3">
      <div class="flex items-baseline gap-4">
        <div class="font-mono text-[10px] uppercase tracking-[0.3em] text-emerald-600 dark:text-emerald-400">§ 7.7</div>
        <h2 class="font-display text-3xl tracking-tight">대표 <span class="italic">Extensions</span></h2>
      </div>
      <a href={`${base}extensions/`} class="font-mono text-[11px] uppercase tracking-[0.2em] text-ink-500 hover:text-brand-600 transition-colors">
        all 30 →
      </a>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {featuredSE.map((se) => <ExtensionCard se={se} />)}
    </div>
  </section>

  <!-- Colophon -->
  <section class="py-14">
    <div class="relative border hairline p-7 lg:p-10 dot-grid-fine">
      <span class="absolute -top-px left-6 px-2 bg-white dark:bg-ink-900 font-mono text-[10px] uppercase tracking-[0.3em] text-ink-400">
        · colophon ·
      </span>
      <div class="grid md:grid-cols-[1fr_auto] gap-6 items-start max-w-5xl">
        <p class="text-[14px] leading-[1.75] text-ink-600 dark:text-ink-300 text-pretty">
          본 사이트의 설명은 <code class="font-mono text-[13px] text-ink-800 dark:text-ink-100 bg-ink-100 dark:bg-ink-800 px-1.5 py-0.5 rounded-sm">O-RAN.WG4.TS.CUS.0-R005-v20.00</code> 스펙 문서를 기본으로 하고, Techplayon의 fronthaul 가이드, Telecom Trainer의 O-RAN 인터페이스 설명, O-RAN Software Community 문서, 그리고 공개된 빔포밍 가중치 관련 특허 문서들의 일반 공개 자료를 참고해 작성되었습니다. 구체적인 비트 폭이나 필드 의미는 스펙 본문을 최종 출처로 삼아야 합니다.
        </p>
        <div class="font-mono text-[10px] uppercase tracking-[0.22em] text-ink-500 space-y-1.5 md:text-right">
          <div>Educational use only</div>
          <div class="text-ink-400">v20.00 · 2024-Q4</div>
          <div class="pt-2">
            <a href={`${base}fields/`} class="text-brand-600 hover:underline">→ field index</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
